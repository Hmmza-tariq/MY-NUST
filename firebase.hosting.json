{
  "hosting": {
    "site": "mynust",
    "public": "site",
    "ignore": ["**/.*", "README.md", "**/node_modules/**"],
    "headers": [{"source": "**", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
    ]}]
  }
}
